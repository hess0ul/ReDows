<Window x:Class="ReDows.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReDows" Height="720" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource App.Background}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource App.Surface}" Padding="22,16"
                BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="ReDows" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Inventory &amp; backup before a Windows reset. Read-only on your PC."
                           Foreground="{StaticResource App.Muted}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource App.Surface}"
                    BorderBrush="{StaticResource App.Border}" BorderThickness="0,0,1,0">
                <!-- Nav items are radio buttons so the CURRENT screen stays highlighted (accent pill).
                     TwoWay + a ConvertBack that does nothing keeps the binding alive across clicks. -->
                <StackPanel Margin="0,10,0,0">
                    <RadioButton Content="Home" Tag="&#xE80F;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowHomeCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=home, Mode=TwoWay}"/>
                    <RadioButton Content="Scan" Tag="&#xE721;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowScanCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=scan, Mode=TwoWay}"/>
                    <RadioButton Content="Review" Tag="&#xE9D5;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowReviewCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=review, Mode=TwoWay}"/>
                    <RadioButton Content="Backup" Tag="&#xE74E;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowBackupCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=backup, Mode=TwoWay}"/>
                    <RadioButton Content="Restore" Tag="&#xE777;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowRestoreCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=restore, Mode=TwoWay}"/>
                    <RadioButton Content="Apps" Tag="&#xE71D;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowAppsCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=apps, Mode=TwoWay}"/>
                    <RadioButton Content="Settings" Tag="&#xE713;" GroupName="nav" Style="{StaticResource NavItem}"
                                 Command="{Binding ShowSettingsCommand}"
                                 IsChecked="{Binding CurrentScreen, Converter={StaticResource IsScreen}, ConverterParameter=settings, Mode=TwoWay}"/>
                    <RadioButton Content="Secrets" Tag="&#xE72E;" GroupName="nav" Style="{StaticResource NavItem}" IsEnabled="False"/>
                    <TextBlock Text="More screens coming next." Foreground="{StaticResource App.Muted}"
                               FontSize="11" Margin="20,12,10,0"/>
                </StackPanel>
            </Border>

            <!-- A slightly translucent backdrop: identical to today without Mica, a subtle sheen with it. -->
            <Border Grid.Column="1" Background="#E61B1B1F">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
