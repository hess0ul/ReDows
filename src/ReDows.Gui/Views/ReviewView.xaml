<UserControl x:Class="ReDows.Gui.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Review — drop what you don't need" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Everything under review is kept by default. Drop the junk — it leaves the list and goes to the trash (you can restore it). One folder at a time."
                       Foreground="{StaticResource App.Muted}" Margin="0,4,0,10"/>

            <!-- Optional AI assistant: OFF by default, local endpoint by default (nothing leaves this PC). -->
            <Expander Header="AI assistant (optional) — explain unknown folders" Margin="0,0,0,12">
                <Border Background="{StaticResource App.Card}" CornerRadius="6" Padding="14,12" Margin="0,8,0,0"
                        BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                    <StackPanel>
                        <CheckBox Content="Enable AI analysis" IsChecked="{Binding Ai.IsEnabled}"/>
                        <TextBlock Foreground="{StaticResource App.Muted}" FontSize="12" Margin="0,6,0,10" TextWrapping="Wrap"
                                   Text="Only folder and file NAMES and sizes are sent — never file contents. The default endpoint is a local AI on this PC (LM Studio; Ollama uses port 11434), so by default nothing leaves your machine. If you point this at a REMOTE service, those names and sizes leave your PC."/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Endpoint:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Ai.BaseUrl}" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Test connection" Style="{StaticResource GhostButton}"
                                    Command="{Binding Ai.TestCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <PasswordBox Grid.Column="1" x:Name="AiApiKey" VerticalAlignment="Center" Padding="6,4"
                                         Background="{StaticResource App.Surface}" Foreground="White"
                                         BorderBrush="{StaticResource App.Border}" CaretBrush="White"
                                         PasswordChanged="AiApiKey_PasswordChanged"/>
                            <TextBlock Grid.Column="2" Text="Model:" VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox Grid.Column="3" Text="{Binding Ai.Model}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Both optional — a local server needs neither. The key is kept in memory only and NEVER saved to disk: you re-enter it after a restart. A cloud service needs a model id (it hosts many)."/>
                        <TextBlock Text="{Binding Ai.ConnectionStatus}" Foreground="{StaticResource App.Muted}"
                                   FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <!-- Analyze all: one suggestion per review folder, shown as you walk the wizard. -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="✨ Analyze all folders" Style="{StaticResource GhostButton}"
                                    Command="{Binding AnalyzeAllCommand}"/>
                            <TextBlock Text="{Binding Ai.BatchStatus}" Foreground="{StaticResource App.Good}"
                                       FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Advanced: any OpenAI-compatible endpoint works here — a local model; a cloud API with your key (for example https://api.openai.com, https://api.anthropic.com, or Gemini's OpenAI-compatible base URL); or a bridge you host toward an AI subscription you already pay for (for example via LiteLLM or a subscription proxy). Note: using a consumer subscription through a bridge may be against the provider's terms — your call."/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>

        <!-- Step header -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StepText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="✨ AI analysis" Style="{StaticResource GhostButton}"
                    Command="{Binding AnalyzeFolderCommand}" Margin="0,0,8,0"
                    Visibility="{Binding Ai.IsEnabled, Converter={StaticResource BoolToVis}}"/>
            <Button Grid.Column="2" Content="✕ Drop this folder" Style="{StaticResource GhostButton}" Command="{Binding DropFolderCommand}"/>
        </Grid>

        <!-- Toolbar: Up + location + sort -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="↑ Up" Style="{StaticResource GhostButton}" Command="{Binding UpCommand}"/>
            <TextBlock Grid.Column="1" Text="{Binding Location}" Foreground="{StaticResource App.Muted}"
                       VerticalAlignment="Center" Margin="14,0,14,0" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Sort:" Foreground="{StaticResource App.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="Size" Style="{StaticResource GhostButton}" Command="{Binding SortBySizeCommand}" Margin="0,0,6,0"/>
                <Button Content="Name" Style="{StaticResource GhostButton}" Command="{Binding SortByNameCommand}" Margin="0,0,6,0"/>
                <Button Content="Type" Style="{StaticResource GhostButton}" Command="{Binding SortByTypeCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Loading -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar IsIndeterminate="True" Height="4" BorderThickness="0"
                         Foreground="{StaticResource App.Accent}" Background="{StaticResource App.Card}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="Reading folder (computing sizes)…" Foreground="{StaticResource App.Muted}"
                           FontSize="12" VerticalAlignment="Center"/>
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"
                        Margin="12,0,0,0" Padding="10,4"/>
            </StackPanel>
        </StackPanel>

        <!-- Error -->
        <Border Grid.Row="4" Background="#3A2A2A" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Error}" Foreground="#FF9B9B"/>
        </Border>

        <!-- AI suggestion for the current folder: analyzing / failed / a suggestion to accept or dismiss -->
        <Border Grid.Row="5" Background="{StaticResource App.Card}" CornerRadius="6" Padding="14,12" Margin="0,0,0,10"
                BorderBrush="{StaticResource App.Accent}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Ai.IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Ai.HasResult}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Ai.HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <!-- Analyzing… (one folder, or the analyze-all batch) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding Ai.IsBusy, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Ai.BusyText}" Foreground="{StaticResource App.Muted}" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding Ai.CancelCommand}"
                            Margin="12,0,0,0" Padding="10,4"/>
                </StackPanel>

                <!-- Failure -->
                <TextBlock Text="{Binding Ai.Error}" Foreground="#FF9B9B" TextWrapping="Wrap"
                           Visibility="{Binding Ai.HasError, Converter={StaticResource BoolToVis}}"/>

                <!-- Suggestion -->
                <StackPanel Visibility="{Binding Ai.HasResult, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Ai.ResultTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Ai.Result.Explanation}" Foreground="{StaticResource App.Muted}"
                               TextWrapping="Wrap" Margin="0,4,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Accept — drop this folder" Padding="12,6" Command="{Binding Ai.AcceptCommand}"
                                Visibility="{Binding Ai.CanAcceptDrop, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"/>
                        <Button Content="Dismiss" Style="{StaticResource GhostButton}" Command="{Binding Ai.DismissCommand}"/>
                    </StackPanel>
                    <TextBlock Text="This is a suggestion from an AI model — it can be wrong. You decide."
                               Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content: the folder list, or the trash panel -->
        <Grid Grid.Row="6">
            <!-- Folder list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTrashOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel>
                    <TextBlock Text="{Binding FolderNote}" Foreground="{StaticResource App.Muted}" Margin="0,4,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FolderNote}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource RowButton}" Margin="0"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" IsEnabled="{Binding IsDirectory}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="{StaticResource App.Muted}" VerticalAlignment="Center"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Kind}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Foreground="{StaticResource App.Muted}"
                                                       VerticalAlignment="Center" TextAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="1" Content="✕ Drop" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Command="{Binding DataContext.DropCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Trash panel -->
            <Border Background="{StaticResource App.Surface}" CornerRadius="8" Padding="14"
                    BorderBrush="{StaticResource App.Border}" BorderThickness="1"
                    Visibility="{Binding IsTrashOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trash — dropped items (won't be backed up). Restore brings one back." FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Close" Style="{StaticResource GhostButton}" Command="{Binding ToggleTrashCommand}"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrashItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" Foreground="{StaticResource App.Muted}"
                                                   VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"/>
                                        <Button Grid.Column="2" Content="Restore" Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Wizard bar: summary | Trash | Next -->
        <Grid Grid.Row="7" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding KeptSummary}" Foreground="{StaticResource App.Good}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"
                       Margin="12,0,12,0" TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="1" Content="{Binding TrashButtonText}" Style="{StaticResource GhostButton}"
                    Command="{Binding ToggleTrashCommand}" Margin="0,0,10,0"/>
            <!-- End of the wizard (or nothing to review) → the "Next" button becomes "Back up →" (jumps to Backup). -->
            <Button Grid.Column="2" Content="Next ▶" Command="{Binding NextCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBackUp}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="Back up →"
                    Command="{Binding DataContext.ShowBackupCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBackUp}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
