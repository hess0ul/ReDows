<UserControl x:Class="ReDows.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Set up the optional AI assistant. It helps sort what the rules can't judge, from your PC. Off by default."
                       Foreground="{StaticResource App.Muted}" Margin="0,4,0,14"/>

            <!-- AI assistant: OFF by default, local endpoint by default (nothing leaves this PC). Configured
                 here; Review's AI buttons use it. -->
            <Border Background="{StaticResource App.Card}" CornerRadius="6" Padding="16,14"
                    BorderBrush="{StaticResource App.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="AI assistant" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <CheckBox Content="Enable AI analysis" IsChecked="{Binding Ai.IsEnabled}"/>

                    <!-- Guided connection: pick the KIND first, then only the fields that kind needs show up. -->
                    <TextBlock Text="Where is the AI?" FontWeight="SemiBold" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Self-hosted (local AI)" Margin="0,0,18,0"
                                     IsChecked="{Binding Ai.IsSelfHosted, Mode=TwoWay}"/>
                        <RadioButton Content="External service"
                                     IsChecked="{Binding Ai.IsExternal, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Second choice, external only: your own API key vs a bridge to a subscription you have. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding Ai.ShowExternalChoice, Converter={StaticResource BoolToVis}}">
                        <RadioButton Content="API (your own key)" Margin="0,0,18,0"
                                     IsChecked="{Binding Ai.IsExternalApi, Mode=TwoWay}"/>
                        <RadioButton Content="Proxy API (a subscription you have)"
                                     IsChecked="{Binding Ai.IsExternalProxy, Mode=TwoWay}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Ai.PrivacyNote}" Foreground="{StaticResource App.Muted}"
                               FontSize="12" Margin="0,10,0,10" TextWrapping="Wrap"/>

                    <!-- Endpoint: always needed (every mode is just a URL under the hood). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Endpoint:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Ai.BaseUrl}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="Test connection" Style="{StaticResource GhostButton}"
                                Command="{Binding Ai.TestCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding Ai.EndpointHint}" Foreground="{StaticResource App.Muted}"
                               FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <!-- API key: only the per-token API needs one. Kept in memory only, never saved. -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding Ai.ShowApiKey, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="API key:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <PasswordBox Grid.Column="1" x:Name="AiApiKey" VerticalAlignment="Center"
                                     PasswordChanged="AiApiKey_PasswordChanged"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Ai.ShowApiKey, Converter={StaticResource BoolToVis}}"
                               Text="The key is kept in memory only and never saved to disk. You re-enter it after a restart."/>

                    <!-- Model: any external service hosts many, so one must be named. -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding Ai.ShowModel, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Ai.Model}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Reply cap: external only (it costs there). Self-hosted runs uncapped, so no field. -->
                    <Grid Margin="0,8,0,0"
                          Visibility="{Binding Ai.ShowMaxTokens, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="AiLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max tokens:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Ai.MaxTokens}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Ai.ShowMaxTokens, Converter={StaticResource BoolToVis}}"
                               Text="Caps each reply to keep a paid service's cost bounded. A self-hosted model on your PC runs with no cap. Reasoning models (they think before answering) need a few thousand."/>

                    <!-- Honest caveat, subscription bridge only. -->
                    <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Visibility="{Binding Ai.ShowProxyNote, Converter={StaticResource BoolToVis}}"
                               Text="You host the bridge yourself (for example via LiteLLM or a subscription proxy). Using a consumer subscription this way may be against the provider's terms. That's your call."/>

                    <TextBlock Text="{Binding Ai.ConnectionStatus}" Foreground="{StaticResource App.Muted}"
                               FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <TextBlock Foreground="{StaticResource App.Muted}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Note: a local &quot;reasoning&quot; model (it thinks before answering) can take a minute or two per folder. That's normal. Pick a faster non-reasoning model (or turn off thinking in your server) for quicker sorting."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
